# ---------------------------------------------------------------------------
# Backend environment variables (EXAMPLE / TEMPLATE)
#
# 1. Copy this file to ".env"      ->  cp .env.example .env
# 2. Fill in your real values in ".env"
# 3. NEVER commit the real ".env" file (it is ignored by git)
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mot_uk?schema=public"

# Port the backend API will listen on.
PORT=4000

# Secret used to sign login tokens (JWT). Use a long random string in real use.
# NEVER commit your real secret — only this placeholder lives in .env.example.
AUTH_SECRET="change-me-to-a-long-random-string"
