.vite/
*.tsbuildinfo

# Capacitor — the generated android/ project IS committed so it's ready to open
# in Android Studio. Its own android/.gitignore excludes build output, the
# Gradle cache and local.properties (which holds the local SDK path).
ios/
.capacitor/
